# Flask
PORT=5000
FLASK_DEBUG=false

# JWT signing secret - replace with a strong random value in production
JWT_SECRET=replace-with-a-long-random-secret

# Evidence Vault AES-256 key (base64 urlsafe, 32 bytes). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SafeStride_VAULT_KEY=replace-with-generated-fernet-key

# Optional: Google Maps API key (frontend map tiles/geocoding)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
